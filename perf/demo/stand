#!/usr/bin/env bash
# The stand of the demo: examples/demo in Docker Compose, its services on the
# cores of docker-compose.perf.yml, by perf/compose-stand of ingots-libs,
# INGOTS_META, the runner telling it. What perf/run calls: up TREE,
# down TREE, perf ARGS...
here=$(cd "$(dirname "$0")" && pwd)
# the Python of the images of both roles, one, as the numbers compare
export DEMO_PYTHON=${DEMO_PYTHON:-3.14}
meta=${INGOTS_META:-$(git -C "$here" rev-parse --show-toplevel)/..}
# the scenarios run from the root of the demo, the stand's modules after
# its own on sys.path: the project of the load is load.py, not project.py
exec "$meta/perf/compose-stand" --stand "$here" --example examples/demo \
    --file docker-compose.raw.yml --file docker-compose.perf.yml "$@"
